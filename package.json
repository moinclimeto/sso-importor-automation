{
  "name": "sso-importor-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Climeto PWP desktop app for CPCB EPR registration and document processing",
  "author": "Climeto",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5180 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "setup:ghostscript": "node scripts/setup-ghostscript.mjs",
    "setup:playwright": "node scripts/setup-playwright.mjs",
    "setup:vcredist": "node scripts/setup-vcredist.mjs",
    "prepare:installer": "node scripts/prepare-installer.mjs",
    "preelectron:build": "node scripts/prepare-installer.mjs",
    "db:sync": "node sync_to_sqlite.js",
    "qr:docker:build": "docker build -t pwp-qr-scanner:latest ./scripts/qr_scanner",
    "qr:scan": "node scripts/test-qr-scan.mjs",
    "test:importer-3a": "node --test shared/importerSection3a.test.js",
    "test:packaging-master": "node --test shared/packagingMasterSync.test.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.3",
    "@sentry/electron": "^7.17.0",
    "@undecaf/barcode-detector-polyfill": "^0.9.23",
    "@undecaf/zbar-wasm": "^0.11.0",
    "@zxing/library": "^0.21.3",
    "axios": "^1.13.2",
    "bullmq": "^6.0.2",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "formik": "^2.4.9",
    "ioredis": "^5.11.1",
    "jimp": "^1.6.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "p-limit": "^7.3.1",
    "pdf-lib": "^1.17.1",
    "pdf-to-img": "^6.2.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "playwright": "^1.62.0",
    "qrcode-reader": "^1.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.3.0",
    "rxing-wasm": "^0.5.7",
    "sharp": "^0.35.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "7zip-bin-full": "^26.2.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.1",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.1.7",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.climeto.pwp",
    "productName": "Climeto PWP",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "src/extractors/**/*",
      "!node_modules/bullmq/**",
      "!node_modules/ioredis/**",
      "!node_modules/msgpackr/**",
      "!node_modules/msgpackr-extract/**",
      "!node_modules/@msgpackr-extract/**"
    ],
    "asarUnpack": [
      "node_modules/playwright/**",
      "node_modules/playwright-core/**",
      "node_modules/sqlite3/**",
      "node_modules/sharp/**",
      "node_modules/@napi-rs/**",
      "node_modules/@undecaf/zbar-wasm/**"
    ],
    "extraResources": [
      {
        "from": "electron/db",
        "to": "db"
      },
      {
        "from": "electron/ghostscript",
        "to": "ghostscript",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/playwright-browsers",
        "to": "playwright-browsers",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/vcredist",
        "to": "vcredist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/app-env",
        "to": "app-env",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
