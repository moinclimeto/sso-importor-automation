# Gemini API key for Doc Processor OCR only (invoice text extraction).
# QR scanning does NOT use Gemini.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional extra keys (GEMINI_API_KEY1, GEMINI_API_KEY2, ...) are rotated automatically.

# Installed Windows app does not read this file from the project folder.
# electron:build copies it into the installer. You can also put the same keys in:
#   %APPDATA%\sso-importor-automation\.env
# then restart Climeto PWP.

# Climeto dashboard API (login, GST verify, PIBO search)
Climeto_Api_BASE_URL=https://api.climeto.in/api
# Optional static token — normally obtained via app login (auth/login)
# Climeto_Api_TOKEN=your_jwt_or_api_token_here

# Optional Vite override for browser-only dev (Electron uses Climeto_Api_BASE_URL)
# VITE_API_BASE_URL=https://api.climeto.in/api

# --- Local QR scanner (Docker / Python / Node) ---
# auto = Docker first, then host Python, then Node ZBar
# docker | python | node
QR_SCAN_MODE=docker

# Docker image name (built via: npm run qr:docker:build)
QR_DOCKER_IMAGE=pwp-qr-scanner:latest

# Optional host Python path (only if QR_SCAN_MODE=python/auto and no Docker)
# PYTHON_PATH=C:\Users\PC\AppData\Local\Programs\Python\Python312\python.exe
# POPPLER_PATH=C:\poppler\Library\bin

# QR_SCAN_DPI=200
# QR_MAX_PAGES=1
# QR_SCAN_TIMEOUT_MS=120000
# QR_SHOW_RAW=1   # test script: also print raw JWT to stderr

# --- Error monitoring / crash tracking ---
# 1) Create a free Sentry project: https://sentry.io  (platform: Electron)
# 2) Put the DSN in .env for local/dev:
# SENTRY_DSN=https://YOUR_PUBLIC_KEY@o0.ingest.sentry.io/PROJECT_ID
# 3) For installed Windows builds, also paste the same DSN into:
#    electron/monitoring/dsn.js  ->  PACKAGED_SENTRY_DSN
# Optional webhook if you want events on your own API too:
# CRASH_REPORT_URL=https://api.climeto.in/api/desktop/crash-reports
# SENTRY_ENVIRONMENT=production
# SENTRY_DEV=1
# PWP_DISABLE_GPU=1
# PWP_FORCE_GPU=1

# --- Windows installer (fresh PC, no Node/Playwright/Ghostscript needed) ---
# npm run electron:build already downloads Chromium, Ghostscript, and VC++ redist
# into vendor/ and packs them into the NSIS installer.
# npm run prepare:installer
