# Gemini API key for Doc Processor OCR only (invoice text extraction).
# QR scanning does NOT use Gemini.
GEMINI_API_KEY=your_gemini_api_key_here

# Climeto dashboard API (GST verify + PIBO search)
Climeto_Api_BASE_URL=https://api.climeto.in/api

# --- Local QR scanner (Docker / Python / Node) ---
# auto = Docker first, then host Python, then Node ZBar
# docker | python | node
QR_SCAN_MODE=docker

# Docker image name (built via: npm run qr:docker:build)
QR_DOCKER_IMAGE=pwp-qr-scanner:latest

# Optional host Python path (only if QR_SCAN_MODE=python/auto and no Docker)
# PYTHON_PATH=C:\Users\PC\AppData\Local\Programs\Python\Python312\python.exe
# POPPLER_PATH=C:\poppler\Library\bin

# QR_SCAN_DPI=200
# QR_MAX_PAGES=1
# QR_SCAN_TIMEOUT_MS=120000
# QR_SHOW_RAW=1   # test script: also print raw JWT to stderr
